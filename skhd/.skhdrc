.shell "/bin/zsh"

lalt - l : yabai -m window --focus east
lalt - k : yabai -m window --focus north
lalt - j : yabai -m window --focus south
lalt - h : yabai -m window --focus west

lalt + shift - l : yabai -m window --swap east
lalt + shift - k : yabai -m window --swap north
lalt + shift - j : yabai -m window --swap south
lalt + shift - h : yabai -m window --swap west

lalt - o : yabai -m display --focus prev
lalt - p : yabai -m display --focus next

lalt - s : yabai -m space --create
lalt - d : yabai -m space --destroy

lalt - 1 : yabai -m space --focus i1
lalt - 2 : yabai -m space --focus i2
lalt - 3 : yabai -m space --focus i3
lalt - 4 : yabai -m space --focus i4
lalt - 5 : yabai -m space --focus i5
lalt - 6 : yabai -m space --focus i6
lalt - 7 : yabai -m space --focus i7
lalt - 8 : yabai -m space --focus i8
lalt - 9 : yabai -m space --focus i9
lalt - q : yabai -m space --focus q
lalt - w : yabai -m space --focus w

lalt + shift - 1 : yabai -m window --space i1
lalt + shift - 2 : yabai -m window --space i2
lalt + shift - 3 : yabai -m window --space i3
lalt + shift - 4 : yabai -m window --space i4
lalt + shift - 5 : yabai -m window --space i5
lalt + shift - 6 : yabai -m window --space i6
lalt + shift - 7 : yabai -m window --space i7
lalt + shift - 8 : yabai -m window --space i8
lalt + shift - 9 : yabai -m window --space i9
lalt + shift - q : yabai -m window --space q
lalt + shift - w : yabai -m window --space w

lalt - return : kitty /Users/kislball

lalt - 0x2b : yabai -m space --layout stack
lalt - 0x2f : yabai -m space --layout bsp
lalt - 0x2c : yabai -m window --toggle float

lalt - n : yabai -m window --focus stack.prev
lalt - m : yabai -m window --focus stack.next

